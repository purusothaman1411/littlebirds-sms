# Copy the values you need into your environment (or IDE run configuration).
# Never commit real values. backend/.env is git-ignored.

DB_URL=jdbc:mysql://localhost:3306/little_birds_sms?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Kolkata
DB_USER=root
DB_PASSWORD=change-me

# REQUIRED. At least 32 characters; the app refuses to start without it.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
# Optional: how long a login lasts (minutes). Default 480 (8 hours).
# JWT_EXPIRY_MINUTES=480

# First Headmaster account. Only used when the staff_users table is empty. Password: at least 8 characters.
SMS_ADMIN_USERNAME=headmaster
SMS_ADMIN_PASSWORD=change-me-12345
# Optional
# SMS_ADMIN_ID=ST001
# SMS_ADMIN_NAME=Headmaster
